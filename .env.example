# Copy to .env and fill in. Keys come from @saliha person to person, never through git or chat.
OPENAI_API_KEY=
OPENAI_MODEL_FAST=
OPENAI_MODEL_SMART=
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
FIRECRAWL_API_KEY=
# live | cache | fixtures (cache in dev, live only for final checks)
LLM_MODE=cache
LLM_MAX_CALLS_PER_SESSION=6
# Security (all optional; unset = today's behaviour)
# ATTUNE_ENV=prod drops /api/dev/* and the public /openapi.json
ATTUNE_ENV=dev
# If set, /api/dev/* needs header X-Dev-Token with this value
DEV_TOKEN=
# Comma-separated Host names to accept, e.g. localhost,127.0.0.1
ALLOWED_HOSTS=
# Rate limits / quotas as count/seconds, per IP and per user; unset = unlimited.
# Scopes: GLOBAL MATERIAL SESSION ANSWER EVENTS FEYNMAN VOICE PROBE REFLECT DEV
RL_GLOBAL=
RL_VOICE=
# Leave unset unless a reasoning model needs it (low|medium|high)
OPENAI_REASONING_EFFORT=
# 1 = never call OpenAI on a cache miss (rehearsals)
LLM_FAIL_CLOSED=
